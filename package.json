{
  "name": "cybercore",
  "version": "2.0.0",
  "private": true,
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/security.test.ts",
    "test:integration": "firebase emulators:exec --project demo-cybercore-tests --only auth,database \"node --conditions=react-server --import tsx --test tests/firebase.integration.ts\"",
    "firebase:check": "node --env-file-if-exists=/vercel/share/.env.project scripts/firebase-security.mjs check",
    "firebase:lock": "node --env-file-if-exists=/vercel/share/.env.project scripts/firebase-security.mjs apply"
  },
  "dependencies": {
    "firebase-admin": "14.5.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sharp": "0.35.4",
    "swr": "2.5.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "firebase-tools": "15.31.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
